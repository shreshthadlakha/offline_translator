# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Local ML model cache used by scripts/quality-gate (large binaries, never commit)
/scripts/quality-gate/.cache/
# --- Private Translator release hygiene -----------------------------------------
# One lockfile: package-lock.json (npm ci is the release path). bun.lock stays
# on disk for the sandbox's bun-based dev flow but is never committed.
/bun.lock

# Generated by scripts/build-worker.mjs (runs on install, dev and build):
# the worker bundle, the rendered service worker and the two build-id stamps.
/public/translator.worker.js
/public/sw.js
/src/workers/build-id.ts
/src/generated/worker-build.ts

# Generated by scripts/copy-ort.mjs from @huggingface/transformers.
/public/ort/

# Runtime artifacts of the sandbox dev environment (recreated on boot).
/db/*.db
/.zscripts/dev.pid

# FLORES-200 benchmark dataset: large, CC-BY-SA 4.0, re-downloadable via
# scripts/benchmark — never committed (the quality table's provenance runs
# in scripts/benchmark/runs/ and benchmark-results.json are committed).
/scripts/benchmark/data/

# Agent session leftovers and the sandbox downloads folder.
/tool-results/
/download/

# IndicTrans2 research material: downloaded model files, upstream library
# tarballs and their extracts are re-downloadable provenance, never committed
# (see scripts/indictrans2/research.json for the pinned sources).
/scripts/indictrans2/cache/
/scripts/indictrans2/*.tar.gz
/scripts/indictrans2/indictranstoolkit-1.1.1/
/scripts/indictrans2/indic_nlp_library-0.92/
/scripts/indictrans2/sacremoses-0.2.0/
/scripts/indictrans2/urduhack-1.1.1/
/scripts/indictrans2/indictrans2-onnx-browser-demo-main/
/scripts/indictrans2/tokenizer_src.json
/scripts/indictrans2/tokenizer_tgt.json

# P3a/P5a downloaded IndicTrans2 int8 model files (checksum-verified research
# copies; the app downloads them from the pinned Hub commits at runtime).
/scripts/benchmark/models/

# Generated by scripts/copy-bergamot.mjs from @mkljczk/bergamot-translator.
/public/bergamot/

# P10 proof harness: untracked dev pages for the browser proof runs.
/public/bergamot-proof*
