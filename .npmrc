# Skip onnxruntime-node's CUDA binary download (its install script fetches
# github.com/microsoft/onnxruntime/releases/download/v1.21.0/onnxruntime-linux-x64-gpu-1.21.0.tgz,
# which is no longer published, and the uncaught 404 fails the whole npm install -
# seen as BUILD_UTILS_SPAWN_1 on Vercel and the identical 404 on any Linux x64
# npm ci, e.g. CI). npm exposes this key to lifecycle scripts as
# npm_config_onnxruntime_node_install_cuda, which onnxruntime-node's
# script/install.js reads; with "skip" it exits 0 before any download.
# The app never runs models through Node on a server (all inference is in the
# browser worker via onnxruntime-web), and the CPU binaries stay bundled in the
# npm package - only the unused CUDA EP is skipped.
onnxruntime-node-install-cuda=skip
